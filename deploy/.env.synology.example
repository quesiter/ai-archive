APP_ORIGIN=https://ai-archive.gyee.tech:18443
ARCHIVE_PORT=18080
ARCHIVE_DATA_DIR=/volume1/docker/ai-conversation-archive/data
ARCHIVE_IMAGE=ai-conversation-archive:latest
ARCHIVE_CGROUP_PARENT=ai-conversation-archive
# Optional project-data soft budget in GiB. Leave blank to show usage without a percentage.
ARCHIVE_STORAGE_BUDGET_GB=
# Processed/failed import ZIP retention; Worker runs cleanup daily at 03:20.
IMPORT_PROCESSED_RETENTION_DAYS=30
IMPORT_FAILED_RETENTION_DAYS=30
# 恢复暂存目录由 Compose 映射到 ARCHIVE_DATA_DIR/restores。
RESTORE_FAILED_RETENTION_DAYS=30
TZ=Asia/Shanghai
POSTGRES_DB=archive
POSTGRES_USER=archive
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=15432
# Generate with: openssl rand -base64 32
APP_MASTER_KEY=replace-with-32-byte-base64-key
LOG_LEVEL=info
