NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://archive:change-me@localhost:15432/archive
APP_ORIGIN=http://localhost:5173
# 32 random bytes encoded as base64. Example: openssl rand -base64 32
APP_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
COOKIE_SECURE=false
# 仅在应用确实位于可信反向代理之后时设置代理跳数（例如 1）。
TRUST_PROXY=false
# 官方 Chrome 组件使用固定扩展 ID；多个来源用英文逗号分隔。
EXTENSION_ORIGINS=chrome-extension://daolmhnfgimkgnnadojnmhkkjdolplfi
# 默认阻止 LLM/SMTP 访问内网、回环与云元数据地址。
ALLOW_PRIVATE_NETWORK_TARGETS=false
IMPORT_INBOX=./imports/inbox
IMPORT_PROCESSED=./imports/processed
IMPORT_FAILED=./imports/failed
# Web 恢复上传暂存目录；App 与 Worker 必须共享。
RESTORE_STAGING=./data/restores
# 恢复在事实表提交前失败时，暂存文件的保留天数；每天 03:20 清理。
RESTORE_FAILED_RETENTION_DAYS=30
# 成功/失败 ZIP 的自动保留天数；每天 03:20 清理过期文件。
IMPORT_PROCESSED_RETENTION_DAYS=30
IMPORT_FAILED_RETENTION_DAYS=30
# 可选：自定义组件发布包目录；默认自动发现仓库 release 目录。
# COMPONENT_RELEASE_DIR=../../release
TZ=Asia/Shanghai
LOG_LEVEL=info
POSTGRES_DB=archive
POSTGRES_USER=archive
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=15432
ARCHIVE_DATA_DIR=./data
ARCHIVE_PORT=18080
# 可选：项目数据软预算（GiB）。留空时只显示数据库与导入文件的实际占用，不计算百分比或告警。
ARCHIVE_STORAGE_BUDGET_GB=
# Compose 项目容器共享的 cgroup 父组，用于汇总本项目 CPU、内存和 Swap。
ARCHIVE_CGROUP_PARENT=ai-conversation-archive
# Docker Compose 内部项目容器监测服务地址；本地非 Docker 开发可留空。
HOST_MONITOR_URL=
