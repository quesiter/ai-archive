{
  "name": "ai-conversation-archive",
  "version": "2.4.12",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @ai-archive/contracts build && pnpm -r --if-present test",
    "test:recapture-postgres": "pnpm --filter @ai-archive/server exec tsx ../../scripts/test-recapture-postgres.ts",
    "test:reliability-postgres": "pnpm --filter @ai-archive/server exec tsx ../../scripts/test-reliability-postgres.ts",
    "test:e2e-api": "node scripts/e2e-api.mjs",
    "test:e2e-projects": "node scripts/e2e-projects.mjs",
    "test:e2e-isolated": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-isolated-e2e.ps1",
    "release:qualify": "node scripts/release-qualification.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test:packaging": "python scripts/test-release-packaging.py",
    "test:launchers": "python scripts/test-windows-sync-launcher.py && python scripts/test-macos-sync-launcher.py",
    "benchmark:search": "pnpm --filter @ai-archive/server benchmark:search",
    "package:chrome": "pnpm --filter @ai-archive/extension zip && node scripts/package-chrome.mjs",
    "package:nas": "python scripts/package-nas-release.py",
    "package:windows-sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-sync.ps1",
    "package:macos-sync": "python scripts/package-macos-sync.py",
    "package:release": "node scripts/package-release.mjs",
    "lint": "pnpm -r --if-present lint",
    "dev:server": "pnpm --filter @ai-archive/server dev",
    "dev:web": "pnpm --filter @ai-archive/web dev",
    "dev:extension": "pnpm --filter @ai-archive/extension dev",
    "db:migrate": "pnpm --filter @ai-archive/server db:migrate",
    "db:generate": "pnpm --filter @ai-archive/server db:generate"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
